{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix esatic && npm ci --prefix server",
  "buildCommand": "npm run build --prefix esatic",
  "outputDirectory": "esatic/dist",
  "regions": ["iad1"],
  "functions": {
    "api/[name].js": { "maxDuration": 30, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/runtimes/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
