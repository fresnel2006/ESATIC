# Réglages du site en développement seulement (npm run dev). Jamais utilisés pour la version en ligne.
# Mode test : entrer dans les examens sans code d'accès, pour essayer. Le serveur doit l'avoir aussi (server/.env).
VITE_TEST_EXAMS_WITHOUT_CODE=true

# Mode test : bouton « espace enseignant sans mot de passe » sur la page de connexion (le serveur doit l'avoir aussi).
VITE_TEST_OPEN_TEACHER=true
